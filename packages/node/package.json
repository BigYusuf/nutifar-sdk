{
  "name": "@nutifar/node",
  "version": "1.0.3",
  "description": "Official Nutifar Node SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Nutifar backend SDK",
    "Node SDK",
    "Server-side Email, Push, Sms, In-app Notifications",
    "Sends Email, Push, Sms, In-app Notifications",
    "Realtime"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nutifar/core": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}