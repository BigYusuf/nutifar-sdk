{
  "name": "@nutifar/expo",
  "version": "1.0.2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "Nutifar",
    "SDK",
    "email",
    "push",
    "sms",
    "React Native",
    "Expo",
    "Send Email, SMS, Push, In App Notifications",
    "Receive Email, SMS, Push, In App Notifications",
    "Push Notifications",
    "Realtime"
  ],
  "author": "BigYusuf",
  "license": "ISC",
  "description": "Nutifar SDK for Expo React Native",
  "dependencies": {
    "@nutifar/core": "workspace:*",
    "expo-application": "^56.0.3",
    "expo-constants": "^56.0.15",
    "expo-device": "^56.0.4",
    "expo-notifications": "^56.0.13",
    "react-native-mmkv": "^4.3.1",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react-native": "^0.73.0"
  }
}