{
  "name": "nutifar",
  "private": true,
  "description": "The official TypeScript library for the nutifar API",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "clean": "pnpm -r clean",
    "changeset": "npx changeset",
    "version-packages": "pnpm changeset version",
    "release": "pnpm build && pnpm version-packages && pnpm changeset publish",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigYusuf/nutifar-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/BigYusuf/nutifar-sdk/issues"
  },
  "homepage": "https://github.com/BigYusuf/nutifar-sdk#readme",
  "keywords": [
    "nutifar",
    "auth",
    "multi-tenant authentication",
    "user-agnostic authentication",
    "vendor-agnostic authentication",
    "staff-agnostic authentication",
    "rbac",
    "notification",
    "typescript",
    "nodejs",
    "react",
    "react-native",
    "python",
    "java",
    "nextjs"
  ],
  "author": "BigYusuf",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.12.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "picocolors": "^1.1.1"
  }
}